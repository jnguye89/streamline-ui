# Public URLs. Do not include trailing slashes.
UI_ORIGIN=https://demo.example.com
API_BASE_URL=https://api.demo.example.com

# Optional overrides; these are the defaults published by GitHub Actions.
UI_IMAGE=ghcr.io/jnguye89/streamline-ui:demo
API_IMAGE=ghcr.io/jnguye89/streamline-api:demo
# Multi-architecture digest; update intentionally when upgrading cloudflared.
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:e39ee8da81ad5e05d77f38d2f51c60ca51bf2a8450ac3abab50c17fdb91d91bf

RDS_USERNAME=streamline
RDS_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-too
STREAMLINE_DB_NAME=streamline

AUTH0_DOMAIN=tenant.example.auth0.com
AUTH0_ISSUER=https://tenant.example.auth0.com/
AUTH0_AUDIENCE=https://api.demo.example.com/
AUTH0_TV_CLIENT_ID=replace-me

AGORA_APP_ID=replace-me
AGORA_APP_CERT=replace-me
AGORA_CLOUD_RECORDING_ENABLED=false

# Optional demo integrations.
AWS_REGION=us-east-1
AWS_S3_BUCKET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
